# سلسلة عشوائية طويلة لتوقيع أكواد التحقق (OTP). لازم تحطها قبل الإطلاق الفعلي —
# من غيرها بيستخدم قيمة افتراضية غير آمنة. تقدر تولّد وحدة بالأمر ده:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# من غير المتغيرين دول، الكود هيتطبع في الـ terminal بس (وضع تجربة).
# اعمل حساب مجاني على https://resend.com وخد الـ API key من هناك.
RESEND_API_KEY=

# اختياري: من غير ما تعمل verify لدومين بتاعك، سيب القيمة الافتراضية دي
# (Resend بتوفرها للتجربة من غير ما تحتاج تتحقق من دومين).
OTP_FROM_EMAIL="PlatformX <onboarding@resend.dev>"
